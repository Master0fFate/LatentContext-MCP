{
    "name": "latentcontext-mcp",
    "version": "2.1.0",
    "description": "LatentContext MCP Server: session-isolated memory, a knowledge graph, and a live code index with call graphs for MCP hosts",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "bin": {
        "latentcontext-mcp": "dist/index.js"
    },
    "files": [
        "dist",
        "grammars",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json && node scripts/make-bin-executable.mjs",
        "start": "node dist/index.js",
        "dev": "tsx src/index.ts",
        "typecheck": "tsc -p tsconfig.check.json",
        "test": "node --import tsx --test tests/*.test.ts",
        "test:smoke": "node --import tsx --test tests/package-smoke.test.ts",
        "check": "npm run typecheck && npm test",
        "audit:production": "npm audit --omit=dev --audit-level=moderate",
        "benchmark:retrieval": "node --import tsx benchmarks/retrieval.bench.ts",
        "prepack": "npm run build",
        "prepublishOnly": "npm run check && npm audit --audit-level=low"
    },
    "engines": {
        "node": ">=20"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Master0fFate/LatentContext-MCP.git"
    },
    "bugs": {
        "url": "https://github.com/Master0fFate/LatentContext-MCP/issues"
    },
    "homepage": "https://github.com/Master0fFate/LatentContext-MCP#readme",
    "publishConfig": {
        "access": "public"
    },
    "keywords": [
        "mcp",
        "model-context-protocol",
        "mcp-server",
        "llm",
        "context",
        "memory",
        "knowledge-graph",
        "vector-search",
        "claude",
        "cursor",
        "code-search",
        "code-intelligence",
        "call-graph",
        "tree-sitter"
    ],
    "license": "MIT",
    "dependencies": {
        "@huggingface/transformers": "^4.3.1",
        "@modelcontextprotocol/sdk": "^1.32.1",
        "@vscode/tree-sitter-wasm": "^0.3.1",
        "js-tiktoken": "^1.0.21",
        "sql.js": "^1.14.2",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@types/node": "^22.20.5",
        "@types/sql.js": "^1.4.11",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    }
}
