{
    "name": "latentcontext-mcp",
    "version": "1.1.1",
    "description": "LatentContext MCP Server — Intelligent memory and context management for LLMs",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "bin": {
        "latentcontext-mcp": "dist/index.js"
    },
    "scripts": {
        "build": "tsc",
        "start": "node dist/index.js",
        "dev": "tsx src/index.ts",
        "test": "node --import tsx --test tests/*.test.ts",
        "prepack": "npm run build",
        "prepublishOnly": "npm test && npm audit --audit-level=moderate"
    },
    "engines": {
        "node": ">=18"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Master0fFate/LatentContext-MCP.git"
    },
    "bugs": {
        "url": "https://github.com/Master0fFate/LatentContext-MCP/issues"
    },
    "homepage": "https://github.com/Master0fFate/LatentContext-MCP#readme",
    "publishConfig": {
        "access": "public"
    },
    "keywords": [
        "mcp",
        "llm",
        "context",
        "memory",
        "knowledge-graph",
        "vector-search"
    ],
    "license": "MIT",
    "dependencies": {
        "@huggingface/transformers": "^3.4.0",
        "@modelcontextprotocol/sdk": "^1.12.0",
        "js-tiktoken": "^1.0.19",
        "sql.js": "^1.12.0",
        "uuid": "^11.1.0",
        "zod": "^3.24.0"
    },
    "devDependencies": {
        "@types/node": "^22.13.0",
        "@types/uuid": "^10.0.0",
        "tsx": "^4.19.0",
        "typescript": "^5.7.0"
    }
}
